    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
