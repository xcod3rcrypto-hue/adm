{
  "name": "advertex-ai-studio",
  "productName": "ADVERTEX AI Studio",
  "version": "0.2.0",
  "description": "Plataforma desktop para criação, gestão, análise e otimização de anúncios com IA — Meta Ads e Google Ads.",
  "author": "ADVERTEX",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node infra/scripts/make-icons.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "verify:install": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/verify-install.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "sql.js": "1.14.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
