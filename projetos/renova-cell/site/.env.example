# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_VIP_GROUP_URL=                 # e.g. WhatsApp/Telegram/Facebook group invite link
NEXT_PUBLIC_THANKYOU_VIDEO_URL=            # optional onboarding video on /thank-you
NEXT_PUBLIC_VSL_LOCK_SEEK=true             # false = let viewers skip ahead in the VSL
AB_SPLIT_B=0.5                             # share of visitors in variant B (static headline)
# Optional: comma-separated ISO codes. Default = all of Europe + US, CA, LatAm, AU, NZ, Gulf.
# UA and RU are always excluded.
SHIP_COUNTRIES=
COMPANY_POSTAL_ADDRESS="RENOVA CELL, 123 Street, City, ST 00000, USA"   # required in marketing emails (CAN-SPAM)

# ─── Claude (Anthropic) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Supabase (server only — never expose the service role key) ─────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Filled by `npm run stripe:setup`:
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_KIT3=
STRIPE_PRICE_KIT6=
STRIPE_PRICE_SINGLE_SUB=
STRIPE_PRICE_KIT3_SUB=
STRIPE_PRICE_KIT6_SUB=
STRIPE_PRICE_BUMP=
STRIPE_PRICE_UPSELL_KIT6=
STRIPE_PRICE_UPSELL_SUB=

# ─── HeyGen (VSL videos) ────────────────────────────────────────────────
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID_FEMALE=
HEYGEN_AVATAR_ID_MALE=
HEYGEN_AVATAR_ID_SENIOR=                   # optional, falls back to FEMALE
# Voice per persona, optionally per locale (HEYGEN_VOICE_ID_WOMAN_PT wins over HEYGEN_VOICE_ID_WOMAN):
HEYGEN_VOICE_ID_WOMAN=
HEYGEN_VOICE_ID_MAN=
HEYGEN_VOICE_ID_SENIOR=
# Without Supabase you can point straight at hosted files instead:
NEXT_PUBLIC_VSL_URL_WOMAN=
NEXT_PUBLIC_VSL_URL_MAN=
NEXT_PUBLIC_VSL_URL_SENIOR=

# ─── Follow-up automation ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="RENOVA CELL <hello@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000
MAKE_WEBHOOK_URL=                          # optional: forward new leads to Make.com
UNSUBSCRIBE_SECRET=                        # any long random string (openssl rand -hex 32)
CRON_SECRET=                               # Vercel sends it as "Authorization: Bearer ..."

# ─── Rate limiting (recommended in production) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Analytics (load only after cookie consent) ─────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Business settings → Brand safety → Domains → Add → "Meta-tag": paste only the content value.
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_HOTJAR_ID=

# Delivery promise. Unset = "up to 2 business days" in every country we ship to.
# Set it to the countries where that is true; the others show "tracked delivery" and
# Stripe shows STANDARD_DELIVERY_DAYS (max business days) as the estimate.
FAST_DELIVERY_COUNTRIES=
STANDARD_DELIVERY_DAYS=7

# Neutral wording (no "desire" copy): paid (default, visitors from ads + ad reviewers) | always | never
AD_SAFE_MODE=paid

# Meta Conversions API (server-side Purchase from the Stripe webhook). Token: Events Manager →
# your pixel → Settings → Conversions API → Generate access token.
META_CAPI_TOKEN=
# Optional: test code from Events Manager → Test events (remove in production).
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v24.0
